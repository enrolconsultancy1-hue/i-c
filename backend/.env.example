# eye see backend — copy to `.env` and fill in your keys.

# Server
HOST=0.0.0.0
PORT=8000

# Gemini (Google AI Studio) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google Maps — Directions API — https://console.cloud.google.com
GOOGLE_MAPS_API_KEY=

# Comma-separated allowed origins for CORS (Expo web / dev). Default: *
CORS_ORIGINS=*
